{
  "name": "desklatch",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "A host-controlled computer-use runtime for AI agents",
  "type": "module",
  "bin": {
    "desklatch-mcp": "./dist/bin/mcp.js",
    "desklatch-setup": "./dist/bin/setup.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wszkxlllll/desklatch.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/backends/browser/index.d.ts",
      "import": "./dist/backends/browser/index.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "import": "./dist/demo.js"
    },
    "./windows": {
      "types": "./dist/backends/windows/index.d.ts",
      "import": "./dist/backends/windows/index.js"
    },
    "./cua-background": {
      "types": "./dist/backends/cua-background/index.d.ts",
      "import": "./dist/backends/cua-background/index.js"
    },
    "./e2b": {
      "types": "./dist/backends/e2b/index.d.ts",
      "import": "./dist/backends/e2b/index.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js"
    },
    "./dsh": {
      "types": "./dist/integrations/dsh.d.ts",
      "import": "./dist/integrations/dsh.js"
    },
    "./mcp": {
      "types": "./dist/integrations/mcp.d.ts",
      "import": "./dist/integrations/mcp.js"
    },
    "./openai-agents": {
      "types": "./dist/integrations/openai-agents.d.ts",
      "import": "./dist/integrations/openai-agents.js"
    },
    "./evidence": {
      "types": "./dist/evidence/index.d.ts",
      "import": "./dist/evidence/index.js"
    },
    "./reuse": {
      "types": "./dist/reuse.d.ts",
      "import": "./dist/reuse.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./schema": "./schema/act-input.schema.json"
  },
  "files": [
    "dist/",
    "schema/",
    "docs/",
    "examples/",
    "src/evidence/README.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:distribution": "npm run build && node scripts/pack-distribution.mjs --pack-only",
    "pack:install": "npm run build && node scripts/pack-distribution.mjs",
    "verify:zhipu": "npm run build && node examples/zhipu-acceptance.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@langchain/core": "^1.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.22.0",
    "@trycua/cua-driver": "0.54.0",
    "koffi": "^3.3.8",
    "playwright-core": "^1.65.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-user-approval": { "optional": true },
    "@openai/agents": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@trycua/cua-driver": {
      "optional": true
    },
    "koffi": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@e2b/desktop": "2.5.0",
    "@langchain/core": "1.4.2",
    "@langchain/langgraph": "1.7.5",
    "@langchain/openai": "1.8.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/agents": "0.22.0",
    "@trycua/cua-driver": "0.54.0",
    "@types/node": "22.10.2",
    "koffi": "3.3.8",
    "openai": "7.45.1",
    "playwright-core": "1.65.1",
    "typescript": "5.7.2",
    "zod": "4.6.7"
  },
  "bugs": {
    "url": "https://github.com/wszkxlllll/desklatch/issues"
  },
  "homepage": "https://github.com/wszkxlllll/desklatch#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
